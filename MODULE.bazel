"""Product suite (PLAN.md, Component 1). Every toolchain and ruleset is pinned."""

module(name = "suite")

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

# C/C++ for Linux targets (cgo in Go's toolchain): a pinned Zig-based compiler, so runners need
# no system compiler. Only the Linux toolchains are registered: Zig can't link against macOS
# system libraries, so macOS builds keep using Xcode's clang. glibc 2.28 is the minimum the
# binaries need (runners run Ubuntu 24.04, glibc 2.39).
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

zig_toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig_toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.28",
    "@zig_sdk//toolchain:zig",
)

# Go
bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "gazelle", version = "0.54.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.2")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Gazelle's Python plugin parses with go-tree-sitter; its python/ package doesn't link with lld
# (Linux, hermetic_cc_toolchain) without this. See the patch for why.
go_deps.module_override(
    patch_strip = 1,
    patches = ["//tools/go:go-tree-sitter-python-alloc.patch"],
    path = "github.com/smacker/go-tree-sitter",
)
use_repo(go_deps, "com_github_google_uuid")

# Pinned CLI tools (uv), run with `bazel run @multitool//tools/<tool>:workspace_root -- ...`.
bazel_dep(name = "rules_multitool", version = "1.11.1")

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//:multitool.lock.json")
use_repo(multitool, "multitool")

# Python: hermetic CPython; third-party wheels from requirements_lock.txt (exported from uv.lock).
bazel_dep(name = "rules_python", version = "2.4.2")
bazel_dep(name = "rules_python_gazelle_plugin", version = "2.4.2")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.13",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "pypi")

# TypeScript / web: Node toolchain, pnpm workspace (pnpm-lock.yaml), tsc, Jest.
bazel_dep(name = "rules_nodejs", version = "6.7.6")
bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "aspect_rules_jest", version = "0.26.0")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.20.0")

# Bazel-managed pnpm: bazel run -- @pnpm//:pnpm --dir $PWD install --lockfile-only
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "10.34.6",
)
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript")
typescript.deps(
    version_from = "//:package.json",
)
use_repo(typescript, "npm_typescript")
