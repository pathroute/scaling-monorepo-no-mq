load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "accounts",
    srcs = ["server.go"],
    importpath = "github.com/pathroute/suite/services/accounts",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/go/authz",
        "//libs/go/db",
        "//libs/go/platform",
        "//services/accounts/api",
    ],
)

go_test(
    name = "accounts_test",
    srcs = ["server_test.go"],
    embed = [":accounts"],
    deps = [
        "//libs/go/authz",
        "//libs/go/platform/platformtest",
        "//services/accounts/api",
    ],
)
