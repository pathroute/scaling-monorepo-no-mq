load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ai-gateway",
    srcs = ["server.go"],
    importpath = "github.com/pathroute/suite/services/ai-gateway",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/go/aiclient",
        "//libs/go/authz",
        "//libs/go/platform",
        "//services/ai-gateway/api",
    ],
)

go_test(
    name = "ai-gateway_test",
    srcs = ["server_test.go"],
    embed = [":ai-gateway"],
    deps = [
        "//libs/go/aiclient",
        "//libs/go/authz",
        "//libs/go/platform/platformtest",
        "//services/ai-gateway/api",
    ],
)
